{
  "name": "@ksndjaks/dsh-image-budget-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Proactive image budget guard for DeepSeek Harness sessions: shortens the oldest request images to durable placeholders before the request is assembled, so inline base64 payloads never reach the adapter's image ceiling.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "default": "./dist/projection.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "link:peers": "node scripts/link-peers.mjs",
    "prebuild": "node scripts/link-peers.mjs",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "node scripts/link-peers.mjs && pnpm build",
    "test": "node --test --test-reporter=spec \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "replay": "node scripts/replay-session.mjs",
    "verify:profile": "node scripts/verify-profile.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
